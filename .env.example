# rastreador-importacao/.env.example
# Copie para .env e ajuste. O .env NUNCA vai para o Git.

# --- Banco (somente dados sintéticos) ---
POSTGRES_USER=rastreador
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=rastreador

# --- API ---
APP_ENV=dev
# Segredo para assinar o token do login simples (gere com: python -c "import secrets;print(secrets.token_urlsafe(32))")
SECRET_KEY=troque-este-segredo
# Usuário único do login simples
ADMIN_USER=admin
ADMIN_PASSWORD=troque-esta-senha-admin
TOKEN_TTL_MIN=480
# Origem do front liberada no CORS
CORS_ORIGINS=http://localhost:5173

# --- Integração Landed (Etapa 4) ---
# Dentro do Docker, para alcançar a Landed rodando no host Windows, use host.docker.internal
LANDED_URL=http://host.docker.internal:8001
LANDED_TIMEOUT_S=5

# --- Front-end ---
VITE_API_URL=http://localhost:8000
